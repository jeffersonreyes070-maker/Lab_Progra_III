# Copiar este archivo como ".env" y llenar los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# En Render estos mismos valores van en "Environment Variables".

# Base de datos (Neon -> Connection string)
DATABASE_URL=postgresql://usuario:contraseña@servidor.neon.tech/neondb?sslmode=verify-full

# Crear/actualizar la tabla desde la entidad: true solo la primera vez o si cambia la entidad
DB_SYNCHRONIZE=false

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_NOMBRE=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret

# Administrador del panel
ADMIN_USUARIO=admin
ADMIN_PASSWORD=guapinol123

# Dirección del sitio publicado (solo en Render). Si son varias, separadas por coma.
# FRONTEND_URL=https://artesanias-guapinol.onrender.com,https://www.mi-dominio.me
