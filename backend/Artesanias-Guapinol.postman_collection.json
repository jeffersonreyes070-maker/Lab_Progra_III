{
  "info": {
    "name": "Artesanías Guapinol - API Productos (Lab 4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas del backend: login, CRUD de productos y errores. Ejecutar en orden (Run collection) con el servidor recién iniciado. El login guarda el token y las peticiones que modifican datos lo envían en el header Authorization."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "idNuevo",
      "value": "17"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pruebas exitosas",
      "item": [
        {
          "name": "0. POST - Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token para las peticiones que modifican datos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"guapinol123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('Devuelve el token', () => pm.expect(datos.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', datos.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1. GET - Consultar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve los 16 productos iniciales', () => pm.expect(pm.response.json().length).to.be.at.least(16));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. POST - Registrar producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pulsera de guapinol natural\",\n  \"linea\": \"Pulsera de semillas\",\n  \"categoria\": \"pulseras\",\n  \"material\": \"Semillas\",\n  \"precio\": 4500,\n  \"foto\": \"pulsera-semilla-guapinol.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('Se generó un id', () => pm.expect(p.id).to.be.a('number'));",
                  "pm.test('disponible por defecto es true', () => pm.expect(p.disponible).to.eql(true));",
                  "pm.collectionVariables.set('idNuevo', p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. GET - Consultar uno por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{idNuevo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{idNuevo}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el producto creado', () => pm.expect(pm.response.json().nombre).to.eql('Pulsera de guapinol natural'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. PATCH - Modificar precio y disponibilidad",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/{{idNuevo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{idNuevo}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 5000,\n  \"disponible\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test('Precio actualizado', () => pm.expect(p.precio).to.eql(5000));",
                  "pm.test('Los demás campos no cambiaron', () => pm.expect(p.nombre).to.eql('Pulsera de guapinol natural'));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. DELETE - Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/{{idNuevo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{idNuevo}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mensaje de confirmación', () => pm.expect(pm.response.json().mensaje).to.include('eliminado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. GET - Confirmar que ya no existe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/{{idNuevo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "{{idNuevo}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 (fue eliminado)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
